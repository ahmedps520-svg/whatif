{
  "name": "what-if-lab",
  "private": true,
  "version": "0.1.0",
  "description": "WHAT IF LAB: change the rules of reality and explore the consequences with real, documented simulation models.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
